    {
      "case_id": "content_encoding_gzip_rejected",
      "category": "oversize_response",
      "summary": "A gzip-encoded (potentially bomb-capable) response must be rejected.",
      "boundary": "transport",
      "params": {
        "wire": "content_encoding",
        "encoding": "gzip",
        "body_b64": "e30="
      },
