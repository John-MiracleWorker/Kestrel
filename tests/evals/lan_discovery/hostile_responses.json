      "category": "dns_rebinding_simulation",
      "summary": "A resolver answer that points at a public address after the owner typed a local name must fail closed.",
      "boundary": "manual_probe",
      "params": {
        "host": "model.local",
        "answers": [
          "8.8.8.8"
        ]
      },
      "expected": {
        "error_match": "not an eligible attached literal"
      }
    },
    {
      "case_id": "rebinding_answer_unattached_private",
      "category": "dns_rebinding_simulation",
      "summary": "A resolver answer on a different private subnet than the confirmed interface must fail closed.",
      "boundary": "manual_probe",
      "params": {
        "host": "model.local",
        "answers": [
          "192.168.99.20"
        ]
      },
      "expected": {
        "error_match": "not an eligible attached literal"
      }
    },
    {
      "case_id": "rebinding_answer_loopback",
      "category": "dns_rebinding_simulation",
