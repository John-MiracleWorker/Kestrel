{
  "schema": "kestrel.lan-hostile-corpus.v1",
  "secret_sentinel": "sk-kestrelhostilesentinel00",
  "fixture": {
    "interface_os_identity": "darwin:en90",
    "interface_display_name": "Hostile qualification adapter",
    "interface_address": "192.168.90.1/29",
    "interface_index": 9,
    "network": "192.168.90.0/30",
    "probe_host": "192.168.90.2",
    "probe_port": 11434,
    "allowed_hosts": [
      "192.168.90.1",
      "192.168.90.2"
    ],
    "known_ports": [
      1234,
      8000,
      8080,
      11434
    ]
  },
  "cases": [
    {
      "case_id": "public_range_global_unicast",
      "category": "public_range_rejection",
      "summary": "A global-unicast /30 must never become a probe scope.",
      "boundary": "scope",
      "params": {
        "network": "8.8.8.0/30"
      },
      "expected": {
        "error_match": "private interface scope"
      }
    },
    {
      "case_id": "public_range_test_net_documentation",
      "category": "public_range_rejection",
      "summary": "TEST-NET-1 (192.0.2.0/24) is public and must be rejected even though it is unroutable.",
      "boundary": "scope",
      "params": {
        "network": "192.0.2.0/24"
      },
      "expected": {
        "error_match": "private interface scope"
      }
    },
    {
      "case_id": "private_range_not_attached_to_interface",
      "category": "public_range_rejection",
      "summary": "An RFC1918 range the selected interface is not attached to must be rejected.",
      "boundary": "scope",
      "params": {
        "network": "10.200.0.0/24"
      },
      "expected": {
        "error_match": "attached to the selected interface"
      }
    },
    {
      "case_id": "private_range_over_256_hosts",
      "category": "public_range_rejection",
      "summary": "An attached private range wider than 256 active hosts must be rejected.",
      "boundary": "scope",
      "params": {
        "interface_address": "10.90.0.1/16",
        "network": "10.90.0.0/16"
      },
      "expected": {
        "error_match": "at most 256 hosts"
      }
    },
    {
      "case_id": "unspecified_default_route",
      "category": "public_range_rejection",
      "summary": "0.0.0.0/0 must never become a probe scope.",
      "boundary": "scope",
      "params": {
        "network": "0.0.0.0/0"
      },
      "expected": {
        "error_match": "private interface scope"
      }
    },
    {
      "case_id": "ipv6_global_unicast",
      "category": "public_range_rejection",
      "summary": "An IPv6 global-unicast (documentation) prefix must be rejected; only ULA/link-local are eligible.",
      "boundary": "scope",
      "params": {
        "interface_address": "2001:db8::1/64",
        "network": "2001:db8::/64"
      },
      "expected": {
        "error_match": "private interface scope"
      }
    },
    {
