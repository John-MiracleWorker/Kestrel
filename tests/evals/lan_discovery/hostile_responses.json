      }
    },
    {
      "case_id": "rebinding_answer_duplicate",
      "category": "dns_rebinding_simulation",
      "summary": "Duplicate resolver answers must fail closed rather than being silently deduplicated.",
      "boundary": "manual_probe",
      "params": {
        "host": "model.local",
        "answers": [
          "192.168.90.2",
