      },
      "expected": {
        "transport_failure": "http_timeout"
      }
    },
    {
      "case_id": "slowloris_bytes_after_deadline_never_consumed",
      "category": "slowloris_deadline",
      "summary": "Bytes that arrive only after the absolute deadline must never be consumed.",
