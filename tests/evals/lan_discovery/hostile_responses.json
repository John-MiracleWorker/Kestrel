    },
    {
      "case_id": "slowloris_drip_feed",
      "category": "slowloris_deadline",
      "summary": "A server dripping one byte per read must hit the absolute HTTP deadline and never complete.",
      "boundary": "transport",
      "params": {
        "mode": "drip",
