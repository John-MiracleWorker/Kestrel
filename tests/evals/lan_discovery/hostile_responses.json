      "expected": {
        "error_match": "no eligible attached addresses"
      }
    },
    {
      "case_id": "rebinding_answer_flood",
      "category": "dns_rebinding_simulation",
      "summary": "More than 16 resolver answers must fail closed regardless of eligibility.",
