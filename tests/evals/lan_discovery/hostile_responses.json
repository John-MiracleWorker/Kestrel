          "192.168.90.5",
          "192.168.90.6",
          "192.168.90.7",
          "192.168.90.8",
          "192.168.90.9",
          "192.168.90.10",
          "192.168.90.11",
          "192.168.90.12",
          "192.168.90.13",
          "192.168.90.14",
          "192.168.90.15",
          "192.168.90.16",
          "192.168.90.17",
          "192.168.90.18"
        ]
      },
      "expected": {
        "error_match": "no eligible attached addresses"
      }
    },
    {
      "case_id": "redirect_301_to_public",
      "category": "redirect",
      "summary": "A 301 toward a public host must be terminal: never followed, no second socket.",
