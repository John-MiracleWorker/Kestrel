{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.recovery_python_runtime.v1.schema.json",
  "title": "kestrel.recovery_python_runtime.v1",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema",
    "platform",
    "python_version",
    "python_abi",
    "python_executable_path",
    "python_executable_sha256",
    "source_archive_url",
    "source_archive_sha256",
    "runtime_archive_path",
    "runtime_archive_sha256",
    "runtime_archive_size_bytes",
    "runtime_tree_sha256",
    "runtime_file_count",
    "runtime_total_size_bytes"
  ],
  "properties": {
    "schema": {"const": "kestrel.recovery_python_runtime.v1"},
    "platform": {"const": "ubuntu-24.04-x86_64"},
    "python_version": {"const": "3.11.14"},
    "python_abi": {"const": "cp311"},
    "python_executable_path": {"const": "bin/python3.11"},
    "python_executable_sha256": {
      "const": "sha256:dcd2d22a91c5adb37fa3f54a3a16d2ed7616b84931eb606c0fdfbca38395dab8"
    },
    "source_archive_url": {
      "const": "https://github.com/actions/python-versions/releases/download/3.11.14-18393181605/python-3.11.14-linux-24.04-x64.tar.gz"
    },
    "source_archive_sha256": {
      "const": "sha256:295c25eeb4fdad1ec9526a27fbd9b476d7c79b00547d74d809b306381d0796d5"
    },
    "runtime_archive_path": {"const": "recovery/python-runtime.tar.gz"},
    "runtime_archive_sha256": {"$ref": "#/$defs/digest"},
    "runtime_archive_size_bytes": {"$ref": "#/$defs/positive_integer"},
    "runtime_tree_sha256": {"$ref": "#/$defs/digest"},
    "runtime_file_count": {"$ref": "#/$defs/positive_integer"},
    "runtime_total_size_bytes": {"$ref": "#/$defs/positive_integer"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
