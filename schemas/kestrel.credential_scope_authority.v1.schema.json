{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.credential_scope_authority.v1.schema.json",
  "title": "kestrel.credential_scope_authority.v1",
  "type": "object",
  "required": ["schema", "credential_id", "purpose", "principal", "repositories", "grants", "endpoint_allowlist", "issued_at", "expires_at", "revoked", "token_fingerprint", "issuer", "signing_key_fingerprint", "evidence", "provenance", "confidence", "validation_status"],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.credential_scope_authority.v1"},
    "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
    "purpose": {"enum": ["hosted_smoke_dispatch", "hosted_smoke_read", "promotion_dispatcher", "promotion_reconciliation_reader", "recovery_reader", "release_guard"]},
    "principal": {"$ref": "#/$defs/principal"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "x-sort-key": ["full_name", "id"],
      "items": {"$ref": "#/$defs/repository"}
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "x-sort-key": ["repository_full_name", "permission"],
      "items": {
        "type": "object",
        "required": ["repository_full_name", "repository_id", "permission", "level"],
        "additionalProperties": false,
        "properties": {
          "repository_full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "repository_id": {"$ref": "#/$defs/positive_integer"},
          "permission": {"enum": ["Actions", "Administration", "Attestations", "Contents", "Metadata", "Packages"]},
          "level": {"enum": ["admin", "none", "read", "write"]}
        }
      }
    },
    "endpoint_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "x-sort-key": [],
      "items": {"type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /[^\\r\\n]{1,1024}$"}
    },
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "revoked": {"type": "boolean"},
    "token_fingerprint": {"$ref": "#/$defs/digest"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 128},
    "signing_key_fingerprint": {"$ref": "#/$defs/digest"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"type": "integer", "const": 1},
    "validation_status": {"const": "validated"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "principal": {
      "type": "object",
      "required": ["login", "id", "type"],
      "additionalProperties": false,
      "properties": {
        "login": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"$ref": "#/$defs/positive_integer"},
        "type": {"enum": ["Bot", "User"]}
      }
    },
    "repository": {
      "type": "object",
      "required": ["full_name", "id"],
      "additionalProperties": false,
      "properties": {
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "id": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source_bundle_digest", "canonicalization_vector_digest"],
      "additionalProperties": false,
      "properties": {
        "source_bundle_digest": {"$ref": "#/$defs/digest"},
        "canonicalization_vector_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "provider", "method"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "scripts/release_control_receipt.py"},
        "provider": {"const": "controller"},
        "method": {"const": "owner-signed-credential-scope"}
      }
    }
  }
}
