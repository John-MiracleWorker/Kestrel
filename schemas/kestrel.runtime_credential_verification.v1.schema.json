{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.runtime_credential_verification.v1.schema.json",
  "title": "kestrel.runtime_credential_verification.v1",
  "type": "object",
  "required": ["schema", "credential_id", "purpose", "token_fingerprint", "verified_at", "endpoint_results", "scope_authority_digest", "evidence", "provenance", "confidence", "validation_status"],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.runtime_credential_verification.v1"},
    "credential_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
    "purpose": {"enum": ["hosted_smoke_dispatch", "hosted_smoke_read", "promotion_dispatcher", "promotion_reconciliation_reader", "recovery_reader", "release_guard"]},
    "token_fingerprint": {"$ref": "#/$defs/digest"},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "endpoint_results": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "x-sort-key": ["endpoint"],
      "items": {
        "type": "object",
        "required": ["endpoint", "http_status", "response_digest", "allowed"],
        "additionalProperties": false,
        "properties": {
          "endpoint": {"type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /[^\\r\\n]{1,1024}$"},
          "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
          "response_digest": {"$ref": "#/$defs/digest"},
          "allowed": {"type": "boolean"}
        }
      }
    },
    "scope_authority_digest": {"$ref": "#/$defs/digest"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"type": "integer", "const": 1},
    "validation_status": {"const": "validated"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "evidence": {
      "type": "object",
      "required": ["source_bundle_digest", "canonicalization_vector_digest"],
      "additionalProperties": false,
      "properties": {
        "source_bundle_digest": {"$ref": "#/$defs/digest"},
        "canonicalization_vector_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "provider", "method"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "scripts/release_control_receipt.py"},
        "provider": {"const": "controller"},
        "method": {"const": "runtime-credential-verification"}
      }
    }
  }
}
