{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.source_observation.v1.schema.json",
  "title": "kestrel.source_observation.v1",
  "type": "object",
  "required": ["schema", "name", "provider", "locator", "authenticated_as", "freshness_class", "captured_at", "page_count", "record_count", "complete", "body_encoding", "body"],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.source_observation.v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider": {"enum": ["controller", "github.com", "local", "pypi.org"]},
    "locator": {"type": "string", "minLength": 1, "maxLength": 16384},
    "authenticated_as": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]},
    "freshness_class": {"enum": ["current", "historical"]},
    "captured_at": {"$ref": "#/$defs/timestamp"},
    "page_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "record_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "complete": {"const": true},
    "body_encoding": {"const": "base64"},
    "body": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$", "maxLength": 89478488}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
  }
}
