{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.dispatch_identity.v1.schema.json",
  "title": "kestrel.dispatch_identity.v1",
  "type": "object",
  "required": ["schema", "transaction_nonce", "dispatch_binding", "dispatch_inputs_digest", "repository", "repository_id", "workflow", "workflow_ref", "workflow_sha", "event_name", "ref", "sha", "run_id", "run_attempt", "actor", "actor_id", "triggering_actor", "observed_at", "evidence", "provenance", "confidence", "validation_status"],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.dispatch_identity.v1"},
    "transaction_nonce": {"$ref": "#/$defs/nonce"},
    "dispatch_binding": {"$ref": "#/$defs/digest"},
    "dispatch_inputs_digest": {"$ref": "#/$defs/digest"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "repository_id": {"$ref": "#/$defs/id"},
    "workflow": {"type": "string", "minLength": 1, "maxLength": 256},
    "workflow_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[.]github/workflows/(release[.]yml@refs/(heads/main|tags/v[^/]+)|release-candidate[.]yml@refs/heads/main)$"},
    "workflow_sha": {"$ref": "#/$defs/git_sha"},
    "event_name": {"const": "workflow_dispatch"},
    "ref": {"type": "string", "pattern": "^refs/(heads/main|tags/v[^/]+)$"},
    "sha": {"$ref": "#/$defs/git_sha"},
    "run_id": {"$ref": "#/$defs/id"},
    "run_attempt": {"const": 1},
    "actor": {"type": "string", "pattern": "^(John-MiracleWorker|[A-Za-z0-9_.-]+\\[bot\\])$"},
    "actor_id": {"$ref": "#/$defs/id"},
    "triggering_actor": {"type": "string", "pattern": "^(John-MiracleWorker|[A-Za-z0-9_.-]+\\[bot\\])$"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"const": 1},
    "validation_status": {"const": "validated"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "evidence": {
      "type": "object",
      "required": ["source_bundle_digest", "canonicalization_vector_digest"],
      "additionalProperties": false,
      "properties": {
        "source_bundle_digest": {"$ref": "#/$defs/digest"},
        "canonicalization_vector_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "provider", "method"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "scripts/release_control_receipt.py"},
        "provider": {"const": "github.com"},
        "method": {"const": "github-context-allowlist"}
      }
    }
  }
}
