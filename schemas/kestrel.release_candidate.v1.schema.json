{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.release_candidate.v1.schema.json",
  "title": "kestrel.release_candidate.v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "tag",
    "source",
    "candidate_run",
    "checks",
    "attestation_subjects",
    "artifacts",
    "artifact_set_digest",
    "planned_surfaces",
    "evidence",
    "provenance",
    "confidence",
    "validation_status"
  ],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.release_candidate.v1"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
    "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"},
    "source": {
      "type": "object",
      "required": ["repository", "repository_id", "commit_sha", "tree_sha", "archive_sha256", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "repository_id": {"$ref": "#/$defs/positive_integer"},
        "commit_sha": {"$ref": "#/$defs/git_sha"},
        "tree_sha": {"$ref": "#/$defs/git_sha"},
        "archive_sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "candidate_run": {
      "type": "object",
      "required": ["workflow_id", "workflow_ref", "workflow_sha", "run_id", "run_attempt"],
      "additionalProperties": false,
      "properties": {
        "workflow_id": {"$ref": "#/$defs/positive_integer"},
        "workflow_ref": {"const": "refs/heads/main"},
        "workflow_sha": {"$ref": "#/$defs/git_sha"},
        "run_id": {"$ref": "#/$defs/positive_integer"},
        "run_attempt": {"type": "integer", "const": 1}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "x-sort-key": ["name"],
      "items": {
        "type": "object",
        "required": ["name", "status", "subject_sha", "run_id", "run_attempt", "receipt_path", "receipt_sha256"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["nine-row-exact-wheel", "oci-layout", "protected-main-ci", "release-payload", "release-rehearsal", "runtime-reliability-qualification"]},
          "status": {"type": "string", "const": "success"},
          "subject_sha": {"$ref": "#/$defs/git_sha"},
          "run_id": {"$ref": "#/$defs/positive_integer"},
          "run_attempt": {"type": "integer", "const": 1},
          "receipt_path": {"$ref": "#/$defs/relative_path"},
          "receipt_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "attestation_subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 513,
      "uniqueItems": true,
      "x-sort-key": ["kind", "name"],
      "items": {
        "type": "object",
        "required": ["kind", "name", "digest"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["file", "oci_index"]},
          "name": {"type": "string", "minLength": 1, "maxLength": 512},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "x-sort-key": ["path"],
      "items": {
        "type": "object",
        "required": ["path", "media_type", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^(release|containers)/[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"},
          "media_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"},
          "sha256": {"$ref": "#/$defs/digest"},
          "size_bytes": {"$ref": "#/$defs/positive_integer"}
        }
      }
    },
    "artifact_set_digest": {"$ref": "#/$defs/digest"},
    "planned_surfaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "x-sort-key": [],
      "items": {"enum": ["ghcr", "github_release", "github_tag", "pypi"]}
    },
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"type": "integer", "const": 1},
    "validation_status": {"const": "validated"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "positive_integer": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "relative_path": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"},
    "evidence": {
      "type": "object",
      "required": ["source_bundle_digest", "canonicalization_vector_digest"],
      "additionalProperties": false,
      "properties": {
        "source_bundle_digest": {"$ref": "#/$defs/digest"},
        "canonicalization_vector_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "provider", "method"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "scripts/release_candidate_manifest.py"},
        "provider": {"const": "github.com"},
        "method": {"const": "candidate-run-finalization"}
      }
    }
  }
}
