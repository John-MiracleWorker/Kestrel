{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kestrel.dev/schemas/kestrel.dispatch_tombstone.v1.schema.json",
  "title": "kestrel.dispatch_tombstone.v1",
  "type": "object",
  "required": ["schema", "transaction_nonce", "dispatch_binding", "known_run_ids", "prohibition", "reason_code", "created_at", "channel_locator", "evidence", "provenance", "confidence", "validation_status"],
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "properties": {
    "schema": {"const": "kestrel.dispatch_tombstone.v1"},
    "transaction_nonce": {"$ref": "#/$defs/nonce"},
    "dispatch_binding": {"$ref": "#/$defs/digest"},
    "known_run_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true,
      "x-sort-key": [],
      "items": {"$ref": "#/$defs/id"}
    },
    "prohibition": {"const": "never_issue_dispatch_admission"},
    "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "channel_locator": {"type": "string", "pattern": "^github-release://John-MiracleWorker/Kestrel-Release-Recovery/dispatch-tombstone-[0-9a-f]{64}$"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"const": 1},
    "validation_status": {"enum": ["pending_signature", "validated"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "evidence": {
      "type": "object",
      "required": ["source_bundle_digest", "canonicalization_vector_digest"],
      "additionalProperties": false,
      "properties": {
        "source_bundle_digest": {"$ref": "#/$defs/digest"},
        "canonicalization_vector_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "provider", "method"],
      "additionalProperties": false,
      "properties": {
        "producer": {"const": "scripts/release_control_receipt.py"},
        "provider": {"const": "controller"},
        "method": {"const": "dispatch-terminal-tombstone"}
      }
    }
  }
}
